# Copy to .env.local and fill in. .env.local is git-ignored.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only — bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email automation ──
# auth.users id that owns the email_* rows.
EMAIL_AUTOMATION_USER_ID=

# Anthropic (Claude Haiku classifier)
ANTHROPIC_API_KEY=

# Telegram (dedicated bot → notifications chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret token Telegram echoes on webhook calls (set via setWebhook). openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Bearer secret Apps Script sends to authenticate to /api/email/*. openssl rand -hex 32
APPS_SCRIPT_SHARED_SECRET=

# Xolo invoice ingest inbox (used by Apps Script Script Properties, not the server)
XOLO_INGEST=
